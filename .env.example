# Carpool Mauritius, version B. Copy to .env.local only if you want to
# arm a sandbox adapter at build time. The GitHub Pages demo is built
# with none of these set. Empty values and placeholders keep the
# in-browser mocks. Never put a live secret here. This build refuses
# any payments mode other than sandbox, and it refuses keys that do
# not look like test or sandbox keys.

# Must stay sandbox. Any other value is ignored and the TEST simulator stays on.
VITE_PAYMENTS_MODE=sandbox

# Documented for a future PSP. The demo only understands "sandbox".
VITE_PAYMENT_PROVIDER=sandbox

# Pair of TEST keys. Both must be set, and both must look like test
# keys (sk_test_, pk_test_, or a value containing "test" or "sandbox"),
# before the sandbox payment adapter switches on. Still no live charge.
# Example shape, not a real key: sk_test_replace_me
VITE_PAYMENT_SECRET_KEY=
VITE_PAYMENT_PUBLISHABLE_KEY=

# Google Maps JavaScript API. A browser key, restricted by HTTP referrer.
# Leave empty, or set your-google-maps-api-key, to keep the schematic map.
# Directions are not requested.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# SMS / OTP. A sandbox key (the value must contain "test" or "sandbox")
# labels messages as the sandbox adapter. They still appear only in the
# in-app inbox. A live-looking key is refused.
VITE_SMS_API_KEY=
VITE_SMS_SENDER_ID=

# Email. Same rule as SMS: sandbox keys relabel the in-app inbox.
# Nothing is delivered to a real mailbox in this build.
VITE_EMAIL_API_KEY=
VITE_EMAIL_FROM=
